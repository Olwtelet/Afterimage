<script type="application/ld+json">
{
 "@context":"https://schema.org",

 "@type":"BreadcrumbList",

 "itemListElement":[

 {% for crumb in breadcrumbs %}

 {

 "@type":"ListItem",

 "position":{{ loop.index }},

 "name":"{{ crumb.name }}",

 "item":"{{ seo.siteUrl }}{{ crumb.url }}"

 }

 {% if not loop.last %},{% endif %}

 {% endfor %}

 ]

}
</script>