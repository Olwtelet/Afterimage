---
import Base from '~/layouts/Base.astro';
import TestCard from '~/components/signal/TestCard.astro';
import Glitch from '~/components/signal/Glitch.astro';
import SessionSlate from '~/components/ui/SessionSlate.astro';
import SessionCard from '~/components/ui/SessionCard.astro';
import { featuredSession, genresOf, getSessions, stateOf } from '~/lib/catalog';
import { SITE } from '~/lib/site';
import { sessionCodeOf } from '~/lib/format';

const now = new Date();
const sessions = await getSessions();
const featured = featuredSession(sessions, now);
const catalog = sessions.filter((session) => session.slug !== featured?.slug).slice(0, 6);
const genres = genresOf(sessions).slice(0, 12);

const accent = featured?.bar;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  alternateName: SITE.shortName,
  url: SITE.url,
  description: SITE.description,
  inLanguage: SITE.lang,
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    sameAs: [SITE.social.discord, SITE.social.youtube, SITE.social.steam],
  },
};
---

<Base
  title={`${SITE.name} — curadoria semanal de cinema`}
  description={SITE.description}
  schema={schema}
  {...accent ? { accent } : {}}
>
  {/* ===== Carta de ajuste ================================================ */}
  <section class="hero" aria-labelledby="hero-title">
    <TestCard class="hero__card" ident={`FHDOG · ${sessionCodeOf(now)} · 87.6 MHz`} />

    <div class="hero__content u-page">
      <p class="hero__eyebrow u-label m-enter" style="--m-step:0">
        Carta de ajuste · Canal 01
      </p>

      <Glitch
        tag="h1"
        id="hero-title"
        text={SITE.tagline}
        trigger="reveal"
        class="hero__title u-slate u-bleed m-enter"
      />

      <div class="hero__lede page-lede m-enter" style="--m-step:2">
        {SITE.lede.map((line) => <p>{line}</p>)}
      </div>

      <p class="hero__meta u-label m-enter" style="--m-step:3">
        <span>{sessions.length} sessões no arquivo</span>
        <span aria-hidden="true">·</span>
        <span>Sábados às 20:30</span>
        <span aria-hidden="true">·</span>
        <span>Nada cobrado, nada exigido</span>
      </p>
    </div>

    <a class="hero__scroll u-label" href="#arquivo">
      <span>Sintonizar</span>
      <span class="hero__scroll-line" aria-hidden="true"></span>
    </a>
  </section>

  {/* ===== Sessão em destaque ============================================= */}
  {featured && <SessionSlate session={featured} state={stateOf(featured, now)} />}

  {/* ===== Catálogo ======================================================== */}
  <section class="section u-page" id="arquivo" aria-labelledby="catalog-title">
    <div class="section__head m-reveal">
      <div>
        <h2 class="section__title" data-channel="02" id="catalog-title">No arquivo</h2>
        <p class="section__note">Tudo que já atravessou esta tela</p>
      </div>
      <a class="section__link m-underline" href="/programacao/">Grade completa</a>
    </div>

    <div class="catalog m-stagger">
      {
        catalog.map((session, index) => (
          <SessionCard
            session={session}
            state={stateOf(session, now)}
            priority={index < 3}
          />
        ))
      }
    </div>
  </section>

  {/* ===== Gêneros ========================================================= */}
  <section class="section u-page" aria-labelledby="genres-title">
    <div class="section__head m-reveal">
      <div>
        <h2 class="section__title" data-channel="03" id="genres-title">Sinais</h2>
        <p class="section__note">As frequências que atravessam o catálogo</p>
      </div>
      <a class="section__link m-underline" href="/generos/">Todos os gêneros</a>
    </div>

    <ul class="genres m-reveal" role="list">
      {
        genres.map((genre) => (
          <li>
            <a class="chip" href={`/generos/${genre.slug}/`}>
              {genre.name}
              <span class="chip__count">{genre.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  /* ===== Carta de ajuste ==================================================
     O padrão SMPTE ocupa a tela como fundo e a manchete é tipografada por
     cima. O texto está pintado no primeiro frame — a sintonia das barras é
     puramente decorativa e não segura o LCP.                                */
  .hero {
    position: relative;
    display: grid;
    align-content: center;
    min-block-size: clamp(30rem, 86svh, 54rem);
    padding-block: var(--space-2xl);
    overflow: clip;
    isolation: isolate;
  }

  .hero__card {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  /* Véu que rebaixa as barras a um plano de fundo legível. Sem ele o padrão
     a 75% competiria com a tipografia e nada seria lido. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to right, var(--void) 6%, rgb(5 5 6 / 0.66) 58%, rgb(5 5 6 / 0.28)),
      linear-gradient(to bottom, rgb(5 5 6 / 0.55), transparent 28% 68%, var(--void));
  }

  .hero__eyebrow {
    color: var(--ink-white);
    margin-block-end: var(--space-md);
  }

  .hero__title {
    display: block;
    max-inline-size: 15ch;
    color: var(--ink);
  }

  /* Herda o compasso de .page-lede; aqui só o recuo maior do hero. */
  .hero__lede {
    margin-block-start: var(--space-lg);
    max-inline-size: 44ch;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-sm);
    border-block-start: 1px solid var(--line);
    max-inline-size: 40rem;
  }

  /* --- Chamada para descer ------------------------------------------------
     Uma linha que se estende e recolhe, como um cursor procurando o próximo
     bloco. Substitui a seta, que é literal demais para o resto do sistema. */
  .hero__scroll {
    position: absolute;
    inset-block-end: var(--space-lg);
    inset-inline-start: var(--gutter);
    display: inline-grid;
    gap: 0.6rem;
    justify-items: start;
    padding-block: 0.5rem;
    color: var(--ink-mute);
    transition: color var(--dur-wipe) var(--ease-signal);
  }

  .hero__scroll:hover {
    color: var(--ink);
  }

  .hero__scroll-line {
    inline-size: 1px;
    block-size: 2.5rem;
    background: linear-gradient(to bottom, var(--accent-bar), transparent);
    transform-origin: top;
    animation: probe 2.8s var(--ease-signal) infinite;
  }

  @keyframes probe {
    0%,
    100% {
      transform: scaleY(0.35);
      opacity: 0.5;
    }
    45% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @media (min-width: 64rem) {
    .hero__scroll {
      inset-inline-start: 50%;
      translate: -50% 0;
      justify-items: center;
    }
  }

  /* ===== Gêneros ========================================================== */
  .genres {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }
</style>
