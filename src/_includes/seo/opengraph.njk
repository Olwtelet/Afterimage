<meta property="og:type" content="website">

<meta
  property="og:site_name"
  content="{{ seo.siteName }}">

<meta
  property="og:title"
  content="{{ title or seo.title }}">

<meta
  property="og:description"
  content="{{ description or seo.description }}">

<meta
  property="og:url"
  content="{{ seo.siteUrl }}{{ page.url }}">

<meta
  property="og:image"
  content="{{ seo.siteUrl }}{{ image or seo.image }}">

<meta
  property="og:locale"
  content="{{ seo.locale }}">