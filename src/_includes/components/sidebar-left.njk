<!-- Sidebar Esquerda - Navegação & Informações -->

<!-- Menu de Navegação -->
<div class="widget widget-nav">
  <div class="widget-title">NAVEGAR</div>
  <div class="widget-content">
    <nav class="sidebar-nav">
      {% for item in navigation %}
      <a href="{{ item.url }}" class="nav-button">
        <span class="nav-icon">▸</span> {{ item.name }}
      </a>
      {% endfor %}
    </nav>
  </div>
</div>

<!-- Widget Sobre -->
<div class="widget widget-about">
  <div class="widget-title">SOBRE</div>
  <div class="widget-content">
    <p class="widget-text">Você foi ensinado que ser uma boa pessoa significa não causar sofrimento. Nós discordamos.</p>
    <p class="widget-text">A história demonstra que a ausência de ação pode ser tão decisiva quanto a própria ação. Impérios ruíram, regimes prosperaram, injustiças tornaram-se rotina e sociedades inteiras aceitaram o inaceitável. Não porque todos desejavam esse resultado, mas porque poucos decidiram impedi-lo.</p>
    <p class="widget-text">A neutralidade raramente é ausência de posição. Na maioria das vezes, é apenas a forma mais confortável de evitar responsabilidade. É por isso que aqui a escolha nunca é neutra — cada filme exibido carrega uma intenção, um motivo, uma provocação.</p>
  </div>
</div>

<!-- Contador de Visitas -->
<div class="widget widget-counter">
  <div class="widget-title">VISITANTES</div>
  <div class="widget-content">
    <div id="hit-counter" class="hit-counter">
      <span class="counter-digit">0</span>
      <span class="counter-digit">0</span>
      <span class="counter-digit">0</span>
      <span class="counter-digit">0</span>
      <span class="counter-digit">0</span>
      <span class="counter-digit">0</span>
    </div>
    <p class="widget-text small">Você é o visitante #<span id="visitor-num">000000</span></p>
  </div>
</div>

<!-- Transmissão de Rádio -->
<div class="widget widget-radio">
  <div class="widget-title radio-title">
    <span class="radio-icon">📡</span>
    <span class="radio-title-text">TRANSMISSÃO <span class="radio-freq">87.6 MHz</span></span>
  </div>
  <div class="widget-content">
    <div class="radio-frame">
      <span class="radio-corner radio-corner-tl"></span>
      <span class="radio-corner radio-corner-tr"></span>
      <span class="radio-corner radio-corner-bl"></span>
      <span class="radio-corner radio-corner-br"></span>
      <div class="radio-scanline"></div>
      
      <div id="radio-overlay" class="radio-overlay">
        <button type="button" id="radio-start-btn" class="radio-start-btn">
          ▶ INICIAR TRANSMISSÃO
        </button>
        <p class="radio-hint">clique pra sintonizar</p>
      </div>
      <iframe 
        id="radio-player"
        style="border-radius: 6px; opacity: 0.3; pointer-events: none; transition: opacity 0.4s ease; display: block;" 
        src="https://open.spotify.com/embed/playlist/1UXKrx2Yq0VZoDrjOhoIQw?utm_source=generator&theme=0" 
        width="100%" 
        height="352" 
        frameBorder="0" 
        allowfullscreen="" 
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" 
        loading="lazy">
      </iframe>
    </div>
  </div>
</div>

<style>
.radio-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  flex-wrap: wrap;
  text-align: center;
}

.radio-icon {
  animation: radio-blink 1.6s ease-in-out infinite;
}

@keyframes radio-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.radio-title-text {
  letter-spacing: 1px;
}

.radio-freq {
  color: var(--cyber-blue);
  text-shadow: 0 0 8px var(--cyber-blue);
}

.widget-radio .widget-content {
  padding: 8px;
}

.radio-frame {
  position: relative;
  padding: 6px;
  border: 1px solid var(--neon-purple);
  border-radius: 8px;
  box-shadow: 0 0 12px rgba(157, 0, 255, 0.4), inset 0 0 12px rgba(157, 0, 255, 0.15);
  overflow: hidden;
  animation: radio-frame-glow 3s ease-in-out infinite;
}

@keyframes radio-frame-glow {
  0%, 100% { box-shadow: 0 0 12px rgba(157, 0, 255, 0.4), inset 0 0 12px rgba(157, 0, 255, 0.15); }
  50% { box-shadow: 0 0 20px rgba(255, 0, 110, 0.5), inset 0 0 16px rgba(255, 0, 110, 0.2); }
}

.radio-corner {
  position: absolute;
  width: 14px;
  height: 14px;
  border: 2px solid var(--cyber-blue);
  z-index: 3;
  pointer-events: none;
}

.radio-corner-tl { top: 2px; left: 2px; border-right: none; border-bottom: none; }
.radio-corner-tr { top: 2px; right: 2px; border-left: none; border-bottom: none; }
.radio-corner-bl { bottom: 2px; left: 2px; border-right: none; border-top: none; }
.radio-corner-br { bottom: 2px; right: 2px; border-left: none; border-top: none; }

.radio-scanline {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 3px;
  background: linear-gradient(90deg, transparent, var(--cyber-blue), transparent);
  opacity: 0.6;
  z-index: 3;
  pointer-events: none;
  animation: radio-scan 4s linear infinite;
}

@keyframes radio-scan {
  0% { top: 0; }
  100% { top: 100%; }
}

.radio-overlay {
  position: absolute;
  inset: 6px;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: rgba(0, 0, 0, 0.8);
  border-radius: 6px;
  transition: opacity 0.4s ease;
}

.radio-overlay.hidden {
  opacity: 0;
  pointer-events: none;
}

.radio-start-btn {
  padding: 12px 20px;
  background: linear-gradient(135deg, var(--hot-pink), var(--neon-purple));
  border: 2px solid var(--cyber-blue);
  border-radius: 4px;
  color: #ffffff;
  font-family: var(--font-pixel);
  font-size: 11px;
  cursor: pointer;
  box-shadow: 0 0 15px rgba(255, 0, 110, 0.5);
  animation: pulse-radio 2s ease-in-out infinite;
}

@keyframes pulse-radio {
  0%, 100% { box-shadow: 0 0 15px rgba(255, 0, 110, 0.5); }
  50% { box-shadow: 0 0 25px rgba(255, 0, 110, 0.9); }
}

.radio-hint {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--cyber-blue);
  opacity: 0.7;
}
</style>

<script>
(function() {
  const overlay = document.getElementById('radio-overlay');
  const startBtn = document.getElementById('radio-start-btn');
  const player = document.getElementById('radio-player');
  
  startBtn.addEventListener('click', () => {
    player.src = 'https://open.spotify.com/embed/playlist/1UXKrx2Yq0VZoDrjOhoIQw?utm_source=generator&theme=0&autoplay=1';
    player.style.opacity = '1';
    player.style.pointerEvents = 'auto';
    overlay.classList.add('hidden');
  });
})();
</script>