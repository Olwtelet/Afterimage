{
  "name": "filmes-hd-online-gratis",
  "version": "1.0.0",
  "description": "Site de curadoria de filmes com estética Y2K vaporwave",
  "scripts": {
    "clean": "rm -rf _site",
    "dev": "eleventy --serve",
    "build": "eleventy",
    "build:min": "npm run build && node scripts/minify-assets.js",
    "debug": "DEBUG=Eleventy* eleventy",
    "postbuild": "node scripts/generate-sitemap.js",
    "scrape-images": "python3 scripts/image-scraper.py",
    "integrate-images": "./scripts/image-integration.sh",
    "update-images": "python3 scripts/update-post-images.py"
  },
  "keywords": [
    "curadoria",
    "filmes",
    "cinema",
    "y2k",
    "vaporwave",
    "cyberpunk",
    "site-estatico"
  ],
  "author": "Olwtelet",
  "license": "UNLICENSED",
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-img": "^3.1.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "clean-css": "^5.3.3",
    "luxon": "^3.4.3",
    "markdown-it": "^13.0.2",
    "terser": "^5.46.0"
  }
}