<!DOCTYPE html>
<html lang="pt-BR" class="dark-mode">
<head>
  {% include "partials/head.njk" %}
</head>
<body class="scanlines" data-page="{{ page.url }}">
  <!-- Link de acessibilidade para pular pro conteúdo principal -->
  <a href="#main-content" class="skip-link">Pular para o conteúdo</a>
  
  <!-- Container do efeito de rastro do cursor -->
  <div id="cursor-trail"></div>
  
  <!-- Loader da página -->
  <div class="y2k-loader" id="page-loader">
    <div class="loader-inner">
      <div class="loader-disc"></div>
      <div class="loader-text">CARREGANDO</div>
      <div class="loader-bar">
        <div class="loader-bar-fill"></div>
      </div>
    </div>
  </div>
  
  {% include "components/header.njk" %}
  
  <div class="y2k-layout">
    <!-- Barra lateral esquerda -->
    <aside class="sidebar sidebar-left">
      {% include "components/sidebar-left.njk" %}
    </aside>
    
    <!-- Conteúdo principal (centralizado) -->
    <main class="main-content crt-container" id="main-content">
      {{ content | safe }}
    </main>
    
    <!-- Barra lateral direita -->
    <aside class="sidebar sidebar-right">
      {% include "components/sidebar-right.njk" %}
    </aside>
  </div>
  
  {% include "components/footer.njk" %}
  
  <!-- Scripts -->
  {% include "partials/scripts.njk" %}
</body>
</html>