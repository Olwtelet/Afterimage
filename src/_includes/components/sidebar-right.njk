<!-- Sidebar Direita - Widgets & Extras -->

<!-- Widget de Estatísticas -->
<div class="widget widget-stats">
  <div class="widget-title">ESTATÍSTICAS</div>
  <div class="widget-content">
    <div id="stats-widget-sidebar"></div>
  </div>
</div>

<!-- Nuvem de Tags -->
<div class="widget widget-tags">
  <div class="widget-title">TAGS</div>
  <div class="widget-content">
    <div class="tag-cloud-mini">
      {% for tag in collections.tagList | limit(10) %}
      <a href="/tags/{{ tag | slugify }}/" class="mini-tag">{{ tag }}</a>
      {% endfor %}
    </div>
  </div>
</div>

<!-- Webring -->
<div class="widget widget-webring">
  <div class="widget-title">WEBRING</div>
  <div class="widget-content center">
    <div class="webring">
      <a href="{{ site.social.discord }}" target="_blank" rel="noopener" id="webring-current" class="webring-text">[ SERVIDOR DO DISCORD ]</a>
      <div class="webring-nav">
        <button type="button" class="webring-link" id="webring-prev" style="background: transparent; border: none; font: inherit; color: inherit; cursor: pointer; padding: 4px 8px;">« ANTERIOR</button>
        <span class="webring-sep">|</span>
        <button type="button" class="webring-link" id="webring-random" style="background: transparent; border: none; font: inherit; color: inherit; cursor: pointer; padding: 4px 8px;">ALEATÓRIO</button>
        <span class="webring-sep">|</span>
        <button type="button" class="webring-link" id="webring-next" style="background: transparent; border: none; font: inherit; color: inherit; cursor: pointer; padding: 4px 8px;">PRÓXIMO »</button>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var webringLinks = [
    { label: "SERVIDOR DO DISCORD", url: "{{ site.social.discord }}" },
    { label: "GRUPO DA STEAM", url: "{{ site.social.steam }}" },
    { label: "CANAL DO YOUTUBE", url: "{{ site.social.youtube }}" }
  ];
  var currentIndex = 0;
  var currentLink = document.getElementById('webring-current');

  function updateWebring(index) {
    currentIndex = (index + webringLinks.length) % webringLinks.length;
    var item = webringLinks[currentIndex];
    currentLink.textContent = '[ ' + item.label + ' ]';
    currentLink.href = item.url;
  }

  document.getElementById('webring-prev').addEventListener('click', function() {
    updateWebring(currentIndex - 1);
  });
  document.getElementById('webring-next').addEventListener('click', function() {
    updateWebring(currentIndex + 1);
  });
  document.getElementById('webring-random').addEventListener('click', function() {
    var randomIndex;
    do {
      randomIndex = Math.floor(Math.random() * webringLinks.length);
    } while (randomIndex === currentIndex && webringLinks.length > 1);
    updateWebring(randomIndex);
  });
})();
</script>

<!-- Mural -->
<div class="widget widget-guestbook">
  <div class="widget-title">MURAL</div>
  <div class="widget-content">
    <p class="widget-text">Deixe seu recado no mural!</p>
    <a href="/mural/" class="widget-button">ASSINAR AQUI</a>
  </div>
</div>

<!-- Últimos Filmes -->
<div class="widget widget-buttons">
  <div class="widget-title">SESSÕES</div>
  <div class="widget-content">
    <div class="latest-sessions">
      {% for post in collections.filmes | limit(4) %}
      <a href="{{ post.url }}" class="session-link session-link-{{ loop.index }}" title="{{ post.data.title }}">
        {{ post.date | readableDate }}
      </a>
      {% endfor %}
    </div>
  </div>
</div>

<!-- Enviar Email -->
<div class="widget widget-email">
  <div class="widget-content center">
    <a href="mailto:{{ site.email }}" class="email-button">
      <span class="email-icon">✉</span> ENVIAR EMAIL
    </a>
  </div>
</div>

<!-- Última Atualização -->
<div class="widget widget-updated">
  <div class="widget-content center">
    <div class="last-updated">
      <div class="updated-label">ÚLTIMA ATUALIZAÇÃO:</div>
      <div class="updated-date">2026-07-17</div>
    </div>
  </div>
</div>

<!-- Lembrete -->
<div class="widget widget-reminder">
  <div class="widget-title reminder-title">LEMBRE-SE</div>
  <div class="widget-content center">
    <p class="reminder-line">
      Nem todo <span class="reminder-hero">herói</span> está certo.
    </p>
    <p class="reminder-line">
      Nem todo <span class="reminder-villain">vilão</span> está errado.
    </p>
  </div>
</div>

<style>
.latest-sessions {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.session-link {
  display: block;
  padding: 10px 14px;
  text-align: center;
  border-radius: 4px;
  font-family: var(--font-pixel);
  font-size: 11px;
  text-decoration: none;
  color: #ffffff;
  transition: all 0.2s ease;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.session-link:hover {
  transform: scale(1.03);
  filter: brightness(1.15);
}

.session-link-1 { background: var(--neon-purple); }
.session-link-2 { background: var(--hot-pink); color: #000; }
.session-link-3 { background: var(--cyber-blue); color: #000; }
.session-link-4 { background: var(--acid-green); color: #000; }

.reminder-title {
  animation: reminder-flicker 4s ease-in-out infinite;
}

@keyframes reminder-flicker {
  0%, 92%, 100% { opacity: 1; }
  94% { opacity: 0.4; }
  96% { opacity: 1; }
  98% { opacity: 0.6; }
}

.reminder-line {
  font-family: var(--font-mono);
  font-size: 13px;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.85);
  margin: 0;
}

.reminder-hero {
  color: var(--cyber-blue);
  text-shadow: 0 0 8px var(--cyber-blue);
  font-weight: bold;
}

.reminder-villain {
  color: var(--hot-pink);
  text-shadow: 0 0 8px var(--hot-pink);
  font-weight: bold;
}
</style>