---
/**
 * Cabeçalho: marca do canal, navegação numerada e o gatilho da busca.
 *
 * A navegação móvel abre em <dialog>, que traz gestão de foco, fechamento por
 * Esc e inércia do fundo de graça, pela plataforma. O menu antigo era uma div
 * com uma classe alternada por JavaScript, sem aria-expanded e sem armadilha
 * de foco.
 */
import Wordmark from './Wordmark.astro';
import { NAVIGATION } from '~/lib/site';

const path = Astro.url.pathname;
const isCurrent = (href: string): boolean =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="header">
  <div class="header__inner u-page">
    <a href="/" class="header__brand" aria-label="Início">
      <Wordmark />
    </a>

    <nav class="header__nav" aria-label="Principal">
      <ul role="list">
        {
          NAVIGATION.map((item) => (
            <li>
              <a
                href={item.href}
                class="navlink"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                <span class="navlink__channel u-label">{item.channel}</span>
                <span class="navlink__label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <button
        type="button"
        class="search-trigger"
        data-search-open
        aria-label="Buscar sessões"
      >
        <span class="search-trigger__text">Buscar</span>
        <kbd class="search-trigger__key u-mono">⌘K</kbd>
      </button>

      <button
        type="button"
        class="menu-trigger"
        aria-label="Abrir menu"
        aria-haspopup="dialog"
        data-menu-open
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<dialog class="menu" data-menu aria-label="Navegação">
  <div class="menu__inner">
    <button type="button" class="menu__close" data-menu-close aria-label="Fechar menu">
      Fechar
    </button>
    <nav aria-label="Principal, móvel">
      <ul role="list">
        {
          NAVIGATION.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span class="u-label">{item.channel}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const open = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const close = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  open?.addEventListener('click', () => dialog?.showModal());
  close?.addEventListener('click', () => dialog?.close());

  // Clique fora do painel fecha — o backdrop é o próprio <dialog>.
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--void) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    border-block-end: 1px solid var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 3.75rem;
    padding-block-start: var(--strip-height);
  }

  .header__brand {
    display: inline-flex;
    flex: none;
  }

  /* --- navegação de desktop ------------------------------------------------ */
  .header__nav {
    display: none;
  }

  .header__nav ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .navlink {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.5rem 0.7rem;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink-dim);
    position: relative;
    transition: color var(--dur-cut) var(--ease-signal);
  }

  .navlink__channel {
    font-size: 0.5625rem;
    color: var(--ink-mute);
    transition: color var(--dur-cut) var(--ease-signal);
  }

  /* Sublinhado que cresce a partir da esquerda, na cor de acento da página. */
  .navlink::after {
    content: '';
    position: absolute;
    inset-inline: 0.7rem;
    inset-block-end: 0.25rem;
    height: 2px;
    background: var(--accent-bar);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-wipe) var(--ease-signal);
  }

  .navlink:hover,
  .navlink[aria-current='page'] {
    color: var(--ink);
  }

  .navlink:hover .navlink__channel,
  .navlink[aria-current='page'] .navlink__channel {
    color: var(--accent-ink);
  }

  .navlink:hover::after,
  .navlink[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* --- ações --------------------------------------------------------------- */
  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
  }

  .search-trigger {
    display: none;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0.5rem 0.4rem 0.75rem;
    border: 1px solid var(--line);
    color: var(--ink-mute);
    font-size: var(--text-sm);
    transition:
      border-color var(--dur-cut) var(--ease-signal),
      color var(--dur-cut) var(--ease-signal);
  }

  .search-trigger:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .search-trigger__key {
    font-size: 0.625rem;
    padding: 0.15rem 0.3rem;
    border: 1px solid var(--line);
    color: var(--ink-mute);
  }

  .menu-trigger {
    display: grid;
    gap: 5px;
    padding: 0.75rem 0.5rem;
  }

  .menu-trigger span {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: var(--ink);
  }

  @media (min-width: 56rem) {
    .header__nav,
    .search-trigger {
      display: flex;
    }

    .menu-trigger {
      display: none;
    }
  }

  /* --- menu móvel ---------------------------------------------------------- */
  .menu {
    margin: 0;
    inline-size: 100%;
    max-inline-size: 100%;
    block-size: 100%;
    max-block-size: 100%;
    background: var(--void);
    color: var(--ink);
  }

  .menu::backdrop {
    background: rgb(5 5 6 / 0.8);
  }

  .menu[open] {
    animation: menu-in var(--dur-wipe) var(--ease-out);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-1.5rem);
    }
  }

  .menu__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    height: 100%;
    padding: var(--space-lg) var(--gutter);
  }

  .menu__close {
    align-self: flex-end;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .menu ul {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu li {
    border-block-start: 1px solid var(--line);
  }

  .menu li:last-child {
    border-block-end: 1px solid var(--line);
  }

  .menu a {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    padding-block: var(--space-sm);
    font-size: var(--text-2xl);
    font-weight: 700;
    font-variation-settings: 'wdth' 108;
    letter-spacing: var(--track-tight);
  }

  .menu a[aria-current='page'] {
    color: var(--accent-ink);
  }
</style>
