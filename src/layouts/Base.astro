---
/**
 * Casca única de toda página.
 *
 * A transição entre páginas usa @view-transition nativo do CSS: o "corte de
 * canal" acontece sem uma linha de JavaScript e sem router no cliente, ao
 * contrário das bibliotecas de view transition que embarcam runtime.
 */
import Seo from '~/components/Seo.astro';
import Grain from '~/components/signal/Grain.astro';
import SignalStrip from '~/components/signal/SignalStrip.astro';
import Header from '~/components/ui/Header.astro';
import Footer from '~/components/ui/Footer.astro';
import SearchPalette from '~/components/islands/SearchPalette.astro';
import Radio from '~/components/islands/Radio.astro';
import Calibration from '~/components/islands/Calibration.astro';
import { SITE } from '~/lib/site';
import { BARS, type Bar } from '~/lib/smpte';

import '~/styles/global.css';

interface Props {
  title: string;
  socialTitle?: string | undefined;
  description?: string | undefined;
  image?: string | undefined;
  imageAlt?: string | undefined;
  type?: 'website' | 'article';
  schema?: Record<string, unknown> | readonly Record<string, unknown>[] | undefined;
  noindex?: boolean;
  /** Barra SMPTE que tinge a página inteira. */
  accent?: Bar;
  /** Classe extra no <body>, para páginas com fundo próprio. */
  bodyClass?: string;
}

const { accent = BARS.cyan, bodyClass, ...seo } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang} style={`--accent-bar:${accent.bar};--accent-ink:${accent.ink}`}>
  <head>
    <Seo {...seo} />
    <style is:inline>
      /*
       * A ordem das camadas precisa ser declarada AQUI, antes de qualquer outra
       * folha, porque a cascata registra cada camada na primeira vez que a vê.
       *
       * O Astro emite os estilos com escopo de componente em <style> separados, e
       * alguns deles são analisados antes do bundle global. Bastava um desses
       * conter `@layer components` para `components` ser registrada primeiro e
       * `base` — declarada depois — passar a vencê-la. Foi o que aconteceu: as
       * regras de tamanho de título em `components` perdiam para `.u-slate` em
       * `base`, e as manchetes renderizavam com o corpo de 119px, transbordando a
       * própria coluna. Declarar a ordem no <head> torna o resultado
       * independente de como o bundler decide fatiar e ordenar o CSS.
       */
      @layer reset, tokens, base, components, utilities;

      /* Corte de canal entre páginas — nativo, zero JavaScript. */
      @view-transition {
        navigation: auto;
      }
    </style>
  </head>

  <body class={bodyClass}>
    <a href="#conteudo" class="skip">Pular para o conteúdo</a>

    <SignalStrip />
    <Grain />
    <Header />

    <main id="conteudo">
      <slot />
    </main>

    <Footer />
    <SearchPalette />
    <Radio />
    <Calibration />

    <script>
      // Ident de emissora no console. Não aparece na página, não custa layout.
      console.log(
        '%c▌▌▌▌▌▌▌ %cFILMES HD ONLINE GRÁTIS%c\ncuradoria · Olwtelet',
        'color:#C0C000;font-size:14px',
        'color:#E8E9EA;font-weight:700;letter-spacing:2px',
        'color:#7A8087;font-size:11px',
      );
    </script>
  </body>
</html>

<style is:global>
  @layer components {
    .skip {
      position: absolute;
      inset-block-start: -100%;
      inset-inline-start: var(--gutter);
      z-index: var(--z-tune);
      padding: 0.75rem 1rem;
      background: var(--accent-bar);
      color: var(--void);
      font-weight: 700;
      font-size: var(--text-sm);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
      transition: inset-block-start var(--dur-wipe) var(--ease-out);
    }

    .skip:focus {
      inset-block-start: 0.5rem;
    }

    /* O corte de canal.
       A página que sai perde sincronia horizontal, estoura em brilho e some;
       a que entra chega deslocada para o outro lado e se assenta. O `steps()`
       na saída é o que faz o movimento ler como quadro trocando, não como
       transição suave. */
    @media (prefers-reduced-motion: no-preference) {
      ::view-transition-old(root) {
        animation: channel-out 140ms steps(3, end) both;
      }

      ::view-transition-new(root) {
        animation: channel-in 300ms var(--ease-out) both;
      }

      @keyframes channel-out {
        0% {
          opacity: 1;
          transform: translate3d(0, 0, 0);
        }
        40% {
          opacity: 0.9;
          transform: translate3d(-0.8%, 0, 0);
          filter: brightness(1.8) saturate(0.2);
        }
        70% {
          opacity: 0.5;
          transform: translate3d(1.2%, 0, 0);
          filter: brightness(2.6) saturate(0);
        }
        100% {
          opacity: 0;
          transform: translate3d(-2%, 0, 0);
          filter: brightness(3) saturate(0);
        }
      }

      @keyframes channel-in {
        0% {
          opacity: 0;
          transform: translate3d(1.6%, 0, 0);
          filter: brightness(2.2) saturate(0) blur(2px);
        }
        45% {
          opacity: 1;
          filter: brightness(1.15) saturate(0.7) blur(0);
        }
        100% {
          opacity: 1;
          transform: translate3d(0, 0, 0);
          filter: none;
        }
      }
    }
  }
</style>
