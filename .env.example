# =============================================================================
# Copie para `.env` e preencha. O `.env` está no .gitignore.
#
# Em produção, os mesmos nomes vão em Vercel -> Settings -> Environment Variables.
# O build FALHA se algum obrigatório faltar — melhor quebrar no deploy do que
# descobrir em produção que a autenticação nunca funcionou.
# =============================================================================


# --- Supabase ----------------------------------------------------------------
# Painel -> Settings -> API

# Público: pode viver no navegador, é para isso que existe.
PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SEGREDO: ignora RLS por completo. Só em rotas de servidor.
# Vazar esta chave é entregar o banco inteiro.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...


# --- Administração -----------------------------------------------------------
# Discord ID numérico de quem administra (Discord -> Configurações ->
# Avançado -> Modo desenvolvedor, depois botão direito no perfil -> Copiar ID).
#
# É a única fonte de verdade do acesso ao painel, verificada no servidor a cada
# requisição. Trocar isto no navegador não abre nada.
ADMIN_DISCORD_ID=000000000000000000


# --- Discord (opcional) ------------------------------------------------------
# Sem estes, o site funciona: o perfil apenas não mostra cargos nem pertencimento
# ao servidor, e novas sessões não são anunciadas.

# Bot com acesso ao servidor, para ler cargos e conferir quem é membro.
# Discord Developer Portal -> sua aplicação -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# ID do servidor (botão direito no ícone do servidor -> Copiar ID).
DISCORD_GUILD_ID=

# Webhook do canal de anúncios (Canal -> Editar -> Integrações -> Webhooks).
DISCORD_SESSION_WEBHOOK=
