---
/**
 * Marca do canal: as sete barras reduzidas a um bloco, seguidas do nome.
 * É a carta de ajuste em escala de assinatura.
 */
import { BAR_ORDER } from '~/lib/smpte';
import { SITE } from '~/lib/site';

interface Props {
  /** `full` mostra o nome por extenso; `compact` só a sigla. */
  variant?: 'full' | 'compact';
}

const { variant = 'full' } = Astro.props;
---

<span class="mark" data-variant={variant}>
  <span class="mark__bars" aria-hidden="true">
    {BAR_ORDER.map((bar) => <i style={`background:${bar.bar}`} />)}
  </span>

  {
    variant === 'compact' ? (
      <span class="mark__name">{SITE.shortName}</span>
    ) : (
      <>
        {/* As duas formas do nome saem no HTML e quem escolhe é o CSS, porque a
            escolha depende da largura da viewport — coisa que o servidor não
            sabe. O <a> que envolve a marca tem aria-label próprio, então
            nenhuma das duas é lida em voz alta e a duplicata não custa nada. */}
        <span class="mark__name mark__name--short">{SITE.shortName}</span>
        <span class="mark__name mark__name--full">{SITE.name}</span>
      </>
    )
  }
</span>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-inline-size: 0;
  }

  .mark__bars {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    width: 1.75rem;
    height: 1.125rem;
    flex: none;
  }

  .mark__bars i {
    display: block;
  }

  .mark__name {
    font-weight: 750;
    font-size: 0.8125rem;
    font-variation-settings: 'wdth' var(--wdth-tight);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink);
    /* Rede de segurança: um nome mais longo encolhe com reticências em vez de
       empurrar a largura do documento. */
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* O nome por extenso mede 222px. Somado às ações do cabeçalho (132px) e ao
     intervalo entre os dois, dá 378px numa caixa de 343px no iPhone SE — era
     isso que estourava a viewport e fazia o site INTEIRO rolar de lado, em
     todas as rotas. Abaixo de 30rem entra a sigla, que o projeto já usa no
     dock do rádio e no ident do cartão. */
  .mark__name--full {
    display: none;
  }

  @media (min-width: 30rem) {
    .mark__name--short {
      display: none;
    }

    .mark__name--full {
      display: inline;
    }
  }

  /* O grupo inteiro reage ao hover do link que o envolve. */
  :global(a:hover) .mark__bars i {
    animation: flicker 420ms var(--ease-snap);
  }

  :global(a:hover) .mark__bars i:nth-child(2) {
    animation-delay: 30ms;
  }
  :global(a:hover) .mark__bars i:nth-child(4) {
    animation-delay: 60ms;
  }
  :global(a:hover) .mark__bars i:nth-child(6) {
    animation-delay: 90ms;
  }

  @keyframes flicker {
    50% {
      transform: scaleY(0.55);
      filter: brightness(1.7);
    }
  }
</style>
