<meta
name="twitter:card"
content="summary_large_image">

<meta
name="twitter:title"
content="{{ title or seo.title }}">

<meta
name="twitter:description"
content="{{ description or seo.description }}">

<meta
name="twitter:image"
content="{{ seo.siteUrl }}{{ image or seo.image }}">

{% if seo.twitter %}
<meta
name="twitter:site"
content="{{ seo.twitter }}">
{% endif %}