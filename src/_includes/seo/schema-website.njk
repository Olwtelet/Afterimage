<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"WebSite",

  "name":"{{ seo.siteName }}",

  "url":"{{ seo.siteUrl }}",

  "description":"{{ seo.description }}",

  "inLanguage":"pt-BR",

  "publisher":{
      "@type":"Organization",
      "name":"{{ organization.name }}",
      "url":"{{ organization.url }}",
      "logo":{
          "@type":"ImageObject",
          "url":"{{ seo.siteUrl }}{{ organization.logo }}"
      }
  }
}
</script>