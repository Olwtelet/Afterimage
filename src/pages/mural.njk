---
layout: layouts/page.njk
title: Mural
permalink: /mural/
---

<div class="guestbook-container">
  <div class="guestbook-intro">
    <p class="neon-text">📼 Deixe seu recado no mural! Marque presença na parede digital.</p>
    <p style="color: var(--cyber-blue); margin-top: 1rem; font-size: 14px;">
      ✅ Esse mural é compartilhado de verdade — mas todo recado passa por uma breve análise antes de aparecer publicamente.
    </p>
  </div>

  <!-- Formulário do Mural -->
  <div class="guestbook-form-container">
    <h3 class="form-title">✍️ DEIXAR UM RECADO</h3>
    <form id="guestbook-form" class="guestbook-form">
      <div class="form-group">
        <label for="guest-name">Nome:</label>
        <input type="text" id="guest-name" name="name" required maxlength="30" placeholder="Seu nome ou apelido">
      </div>
      
      <div class="form-group">
        <label for="guest-website">Site (opcional):</label>
        <input type="url" id="guest-website" name="website" placeholder="https://seusite.com">
      </div>
      
      <div class="form-group">
        <label for="guest-message">Mensagem:</label>
        <textarea id="guest-message" name="message" required maxlength="500" rows="4" placeholder="Deixe sua mensagem aqui..."></textarea>
        <span class="char-count">0/500</span>
      </div>
      
      <div class="form-group">
        <label for="guest-vibe">Vibe do momento:</label>
        <select id="guest-vibe" name="vibe">
          <option value="😎">😎 Tranquilo</option>
          <option value="🔥">🔥 Fogo</option>
          <option value="✨">✨ Curtindo</option>
          <option value="💀">💀 Morto</option>
          <option value="🌈">🌈 Feliz</option>
          <option value="🎮">🎮 Jogando</option>
          <option value="💻">💻 Codando</option>
          <option value="🎵">🎵 Música</option>
        </select>
      </div>
      
      <button type="submit" class="submit-btn">
        <span class="btn-text">ASSINAR MURAL</span>
      </button>
    </form>
  </div>

  <!-- Recados do Mural -->
  <div class="guestbook-entries-container">
    <h3 class="entries-title">📖 RECADOS DO MURAL</h3>
    <div id="guestbook-entries" class="guestbook-entries">
      <div class="empty-state">Carregando recados...</div>
    </div>
  </div>
</div>

<style>
.guestbook-container {
  max-width: 800px;
  margin: 0 auto;
}

.guestbook-intro {
  padding: 20px;
  background: rgba(184, 78, 255, 0.1);
  border: 2px solid var(--neon-purple);
  border-radius: 8px;
  margin-bottom: 30px;
}

.guestbook-form-container,
.guestbook-entries-container {
  background: rgba(10, 10, 10, 0.9);
  border: 3px solid var(--hot-pink);
  padding: 25px;
  margin-bottom: 30px;
  box-shadow: 0 0 20px rgba(255, 0, 110, 0.3);
}

.form-title,
.entries-title {
  font-family: var(--font-pixel);
  font-size: 14px;
  color: var(--cyber-blue);
  text-shadow: 0 0 10px var(--cyber-blue);
  margin-bottom: 20px;
  text-align: center;
}

.guestbook-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
  position: relative;
}

.form-group label {
  font-family: var(--font-pixel);
  font-size: 11px;
  color: var(--hot-pink);
  text-transform: uppercase;
}

.form-group input,
.form-group textarea,
.form-group select {
  padding: 12px;
  background: rgba(0, 0, 0, 0.8);
  border: 2px solid var(--cyber-blue);
  border-radius: 4px;
  color: #ffffff;
  font-family: var(--font-body);
  font-size: 14px;
  outline: none;
  transition: all 0.3s ease;
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
  border-color: var(--hot-pink);
  box-shadow: 0 0 10px rgba(255, 0, 110, 0.5);
}

.char-count {
  position: absolute;
  bottom: -20px;
  right: 0;
  font-size: 11px;
  color: var(--acid-green);
  font-family: var(--font-mono);
}

.submit-btn {
  padding: 15px 30px;
  background: linear-gradient(135deg, var(--hot-pink), var(--neon-purple));
  border: 2px solid var(--cyber-blue);
  border-radius: 4px;
  color: #ffffff;
  font-family: var(--font-pixel);
  font-size: 12px;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 0 15px rgba(255, 0, 110, 0.5);
}

.submit-btn:hover {
  transform: scale(1.05);
  box-shadow: 0 0 25px rgba(255, 0, 110, 0.8);
}

.submit-btn:active {
  transform: scale(0.98);
}

.submit-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

.guestbook-entries {
  display: flex;
  flex-direction: column;
  gap: 15px;
  max-height: 600px;
  overflow-y: auto;
}

.guestbook-entry {
  padding: 15px;
  background: rgba(0, 0, 0, 0.6);
  border: 2px solid var(--neon-purple);
  border-radius: 4px;
  position: relative;
  animation: entryAppear 0.3s ease;
}

@keyframes entryAppear {
  0% {
    opacity: 0;
    transform: translateY(-10px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.entry-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.entry-name {
  font-family: var(--font-pixel);
  font-size: 12px;
  color: var(--hot-pink);
}

.entry-name a {
  color: var(--cyber-blue);
  text-decoration: none;
}

.entry-name a:hover {
  text-shadow: 0 0 5px var(--cyber-blue);
}

.entry-vibe {
  font-size: 20px;
}

.entry-message {
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
  margin-bottom: 10px;
  word-wrap: break-word;
}

.entry-date {
  font-size: 11px;
  color: var(--acid-green);
  font-family: var(--font-mono);
}

.empty-state {
  text-align: center;
  padding: 40px;
  color: rgba(255, 255, 255, 0.5);
  font-family: var(--font-mono);
}

@media (max-width: 640px) {
  .form-title,
  .entries-title {
    font-size: 10px;
  }
  
  .submit-btn {
    font-size: 10px;
  }
}
</style>

<script>
// Funcionalidade do Mural — Supabase como banco compartilhado real, com moderação
document.addEventListener('DOMContentLoaded', () => {
  const SUPABASE_URL = 'https://ltdmndehucnjnhdohvrz.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_iVf5jl7Zzvaj_-ijfv6_PQ_q58Wzy4r';
  const TABLE = 'mural_entries';
  
  const form = document.getElementById('guestbook-form');
  const entriesContainer = document.getElementById('guestbook-entries');
  const messageInput = document.getElementById('guest-message');
  const charCount = document.querySelector('.char-count');
  const submitBtn = form.querySelector('.submit-btn');
  
  // Contador de caracteres
  messageInput.addEventListener('input', () => {
    const length = messageInput.value.length;
    charCount.textContent = `${length}/500`;
    charCount.style.color = length > 450 ? 'var(--hot-pink)' : 'var(--acid-green)';
  });
  
  // Carrega só os recados JÁ APROVADOS do Supabase
  async function loadEntries() {
    try {
      const response = await fetch(
        `${SUPABASE_URL}/rest/v1/${TABLE}?select=*&approved=eq.true&order=created_at.desc&limit=50`,
        {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`
          }
        }
      );
      
      if (!response.ok) throw new Error('Falha ao carregar recados');
      
      const entries = await response.json();
      
      if (entries.length === 0) {
        entriesContainer.innerHTML = '<div class="empty-state">Nenhum recado ainda. Seja o primeiro a assinar! 📼</div>';
        return;
      }
      
      entriesContainer.innerHTML = entries.map(entry => `
        <div class="guestbook-entry">
          <div class="entry-header">
            <div class="entry-name">
              ${entry.website 
                ? `<a href="${escapeHtml(entry.website)}" target="_blank" rel="noopener">${escapeHtml(entry.name)}</a>` 
                : escapeHtml(entry.name)
              }
            </div>
            <div class="entry-vibe">${entry.vibe || '😎'}</div>
          </div>
          <div class="entry-message">${escapeHtml(entry.message)}</div>
          <div class="entry-date">${formatDate(entry.created_at)}</div>
        </div>
      `).join('');
    } catch (error) {
      console.warn('Erro ao carregar o mural:', error);
      entriesContainer.innerHTML = '<div class="empty-state">Não foi possível carregar o mural agora. Tente recarregar a página.</div>';
    }
  }
  
  // Adiciona novo recado no Supabase (entra como pendente de aprovação)
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    submitBtn.disabled = true;
    
    const formData = new FormData(form);
    const entry = {
      name: formData.get('name'),
      website: formData.get('website') || null,
      message: formData.get('message'),
      vibe: formData.get('vibe')
      // "approved" não é enviado — o banco já cria como false por padrão
    };
    
    try {
      const response = await fetch(`${SUPABASE_URL}/rest/v1/${TABLE}`, {
        method: 'POST',
        headers: {
          'apikey': SUPABASE_KEY,
          'Authorization': `Bearer ${SUPABASE_KEY}`,
          'Content-Type': 'application/json',
          'Prefer': 'return=minimal'
        },
        body: JSON.stringify(entry)
      });
      
      if (!response.ok) throw new Error('Falha ao enviar recado');
      
      form.reset();
      charCount.textContent = '0/500';
      showNotification('✨ Recebido! Seu recado entrou na fila de análise e aparece assim que for aprovado.');
    } catch (error) {
      console.warn('Erro ao enviar recado:', error);
      showNotification('❌ Algo deu errado. Tenta de novo?');
    } finally {
      submitBtn.disabled = false;
    }
  });
  
  // Funções auxiliares
  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }
  
  function formatDate(dateString) {
    const date = new Date(dateString);
    return date.toLocaleString('pt-BR', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  }
  
  function showNotification(message) {
    const notification = document.createElement('div');
    notification.style.cssText = `
      position: fixed;
      top: 20px;
      right: 20px;
      background: var(--hot-pink);
      color: #ffffff;
      padding: 15px 25px;
      border-radius: 4px;
      font-family: var(--font-pixel);
      font-size: 11px;
      box-shadow: 0 0 20px rgba(255, 0, 110, 0.8);
      z-index: 10000;
      max-width: 300px;
    `;
    notification.textContent = message;
    document.body.appendChild(notification);
    
    setTimeout(() => notification.remove(), 4000);
  }
  
  // Carrega recados ao abrir a página
  loadEntries();
});
</script>